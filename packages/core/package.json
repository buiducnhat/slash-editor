{
  "name": "@slash-editor/core",
  "version": "0.8.0",
  "description": "Headless block-editor core: ProseMirror/Tiptap extensions, schema, commands.",
  "homepage": "https://slasheditor.dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/buiducnhat/slash-editor.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./code-block": "./dist/code-block.mjs",
    "./emoji": "./dist/emoji.mjs",
    "./markdown": "./dist/markdown.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack src/index.ts src/markdown.ts src/emoji.ts src/code-block.ts",
    "dev": "vp pack src/index.ts src/markdown.ts src/emoji.ts src/code-block.ts --watch"
  },
  "dependencies": {
    "@tiptap/extension-blockquote": "^3.32.0",
    "@tiptap/extension-code-block": "^3.32.0",
    "@tiptap/extension-code-block-lowlight": "^3.32.0",
    "@tiptap/extension-collaboration": "^3.32.0",
    "@tiptap/extension-collaboration-caret": "^3.32.0",
    "@tiptap/extension-details": "^3.32.0",
    "@tiptap/extension-emoji": "^3.32.0",
    "@tiptap/extension-list": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/markdown": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@tiptap/suggestion": "^3.32.0",
    "lowlight": "^3.3.0",
    "marked": "^17.0.1"
  },
  "devDependencies": {
    "@tiptap/core": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "yjs": "^13.6.0"
  },
  "peerDependencies": {
    "@tiptap/core": "^3.31.0",
    "@tiptap/pm": "^3.31.0",
    "yjs": "^13.6.0"
  }
}

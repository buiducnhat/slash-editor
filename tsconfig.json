{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["es2024", "dom", "dom.iterable"],
    "moduleDetection": "force",
    "module": "preserve",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "paths": {
      "@slash-editor/core": ["./packages/core/src/index.ts"],
      "@slash-editor/react": ["./packages/react/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src",
    "packages/*/tests",
    "demo-react/src",
    "demo-react/tests",
    "demo-react/playwright.config.ts",
    "*.ts"
  ]
}

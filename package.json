{
  "name": "slash-editor",
  "version": "0.0.4",
  "private": true,
  "description": "Notion-style block editor for React: headless core, shadcn-native UI.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/buiducnhat/slash-editor.git"
  },
  "workspaces": [
    "packages/*",
    "demo-react"
  ],
  "type": "module",
  "scripts": {
    "build": "vp run -F './packages/*' build",
    "dev": "vp run -F demo-react dev",
    "demo": "vp run -F demo-react dev",
    "test": "vp test",
    "test:e2e": "vp run -F demo-react test:e2e",
    "check": "vp check",
    "release": "bumpp package.json packages/core/package.json packages/react/package.json --commit --tag --push",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "bumpp": "^11.1.0",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.3",
    "vite-plus": "^0.2.4"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2",
      "onFail": "download"
    }
  }
}

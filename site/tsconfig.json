{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "types": ["node", "bun", "react", "react-dom"],
    "incremental": true,
    "paths": {
      "@slash-editor/core": ["../packages/core/src/index.ts"],
      "@slash-editor/core/markdown": ["../packages/core/src/markdown.ts"],
      "@slash-editor/react": ["../packages/react/src/index.ts"],
      "@/*": ["./registry/*"],
      "~/*": ["./*"],
      "fumadocs-core": ["./node_modules/fumadocs-core/dist/index.d.ts"],
      "fumadocs-core/*": ["./node_modules/fumadocs-core/dist/*"]
    },
    "plugins": [{ "name": "next" }]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "scripts"
  ],
  "exclude": ["node_modules"]
}
